<Project>

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- version for local builds -->
    <LocalVersion>$([System.DateTime]::Now.ToString('yyyy.MMdd.HHmm'))</LocalVersion>
    <Version Condition="'$(Version)' == ''">$(LocalVersion)</Version>
  </PropertyGroup>

</Project>