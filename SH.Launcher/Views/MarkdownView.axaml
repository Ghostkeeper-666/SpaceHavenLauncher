<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
x:Class="SH.Launcher.Views.MarkdownView" >

  <ScrollViewer x:Name="MarkDownScrollViewer" PointerWheelChanged="OnWheel" >
    <StackPanel x:Name="PART_Content" Spacing="0" />
  </ScrollViewer>

</UserControl>
